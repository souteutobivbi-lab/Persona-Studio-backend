 static/index.html | 58 +++++++++++++++++++++++++++++++++++++++++++++--
 1 file changed, 56 insertions(+), 2 deletions(-)

diff --git a/static/index.html b/static/index.html
index c2f88e5..7157bd1 100644
--- a/static/index.html
+++ b/static/index.html
@@ -665,10 +665,14 @@ textarea.inp{resize:vertical;min-height:68px;line-height:1.5;}
               <!-- LOCKED IDENTITY MODE — shown when persona has a LoRA -->
               <div id="portraitLoraMode" style="display:none;">
                 <div style="display:flex;gap:14px;align-items:flex-start;padding:12px;background:var(--g2);border:1px solid rgba(34,197,94,.2);border-radius:10px;margin-bottom:14px;">
-                  <img id="portraitLoraRef" style="width:72px;height:96px;object-fit:cover;border-radius:8px;border:2px solid var(--green);flex-shrink:0;" src=""/>
+                  <div style="flex-shrink:0;position:relative;">
+                    <img id="portraitLoraRef" style="width:80px;height:107px;object-fit:cover;border-radius:8px;border:2px solid var(--green);display:block;" src=""/>
+                    <a id="portraitLoraRefDownload" href="#" download style="position:absolute;bottom:4px;left:0;right:0;text-align:center;font-size:10px;background:rgba(0,0,0,.6);color:#fff;padding:2px 0;border-radius:0 0 6px 6px;text-decoration:none;" onclick="event.preventDefault();downloadLockedPortrait()">↓ Save</a>
+                  </div>
                   <div>
                     <div style="font-size:12px;font-weight:600;color:var(--green);margin-bottom:4px;">🔒 Identity locked — <span id="portraitLoraName"></span></div>
                     <div style="font-size:11px;color:var(--muted);line-height:1.6;">AI will generate a new image of this exact person. Choose what outfit and styling you want for this video.</div>
