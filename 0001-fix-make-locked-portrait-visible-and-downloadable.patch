                 </div>
                 <div class="field" style="margin-bottom:8px;">
@@ -816,9 +820,18 @@ textarea.inp{resize:vertical;min-height:68px;line-height:1.5;}
             <button class="gen-btn" id="mainGenBtn" onclick="startGen()">✦ Generate video</button>
             <button class="btn ghost" id="cancelGenBtn" style="width:100%;margin-top:6px;display:none;" onclick="cancelGen()">✕ Cancel</button>
             <div style="display:none;flex;gap:8px;margin-top:6px;" id="postGenBtns">
-              <button class="btn ghost" style="flex:1;" onclick="downloadVideo(S.lastVideoUrl,'mediahouz-'+((S.persona?.name||'video').replace(/\s+/g,'-').toLowerCase())+'-'+Date.now()+'.mp4')">↓ Download</button>
+              <button class="btn ghost" style="flex:1;" onclick="downloadVideo(S.lastVideoUrl,'mediahouz-'+((S.persona?.name||'video').replace(/\s+/g,'-').toLowerCase())+'-'+Date.now()+'.mp4')">↓ Download video</button>
               <button class="btn primary" style="flex:1;" onclick="publishVideo()">🌐 Publish</button>
             </div>
+            <!-- Portrait download row — shown after video generated -->
+            <div id="portraitDownloadRow" style="display:none;margin-top:8px;padding:10px 12px;background:var(--surface);border:1px solid var(--border);border-radius:9px;display:none;align-items:center;gap:10px;">
+              <img id="portraitDownloadThumb" style="width:40px;height:53px;object-fit:cover;border-radius:6px;border:1px solid var(--border);" src=""/>
+              <div style="flex:1;min-width:0;">
+                <div style="font-size:12px;font-weight:600;">Portrait used in this video</div>
+                <div style="font-size:11px;color:var(--dim);" id="portraitDownloadLabel">Tap to save</div>
+              </div>
+              <button class="btn ghost" style="font-size:12px;padding:6px 14px;flex-shrink:0;" id="portraitDownloadBtn" onclick="downloadPortraitUsed()">↓ Save portrait</button>
