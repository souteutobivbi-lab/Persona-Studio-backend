           </div>
         </div>
 
@@ -3020,6 +3033,20 @@ async function startGen(){
           vp.classList.add(rcls);
           vp.innerHTML=`<video src="${url}" controls autoplay muted loop style="width:100%;height:100%;object-fit:cover;" playsinline></video>`;
           document.getElementById('postGenBtns').style.display='flex';
+          // Show portrait download row
+          if(S.portraitFile){
+            const prow=document.getElementById('portraitDownloadRow');
+            const pthumb=document.getElementById('portraitDownloadThumb');
+            const plabel=document.getElementById('portraitDownloadLabel');
+            if(prow&&pthumb){
+              const objUrl=URL.createObjectURL(S.portraitFile);
+              pthumb.src=objUrl;
+              if(plabel) plabel.textContent=(S.persona?.name||'Portrait')+' · used in this video';
+              prow.style.display='flex';
+              window._lastPortraitUrl=objUrl;
+              window._lastPortraitName=(S.persona?.name||'portrait').replace(/\s+/g,'-').toLowerCase()+'-'+Date.now()+'.png';
+            }
+          }
           btn.textContent='✦ Generate another';btn.disabled=false;
           const vid={jid:job,title:(S.persona?.name||'Persona')+' · '+S.niche,persona:S.persona?.name||'',color:S.persona?.color||'#7c3aed',niche:S.niche,time:new Date().toLocaleString(),url,published:false,ratio:S.ratio.label};
           S.videos.unshift(vid);saveAll();updateDashboard();toast('Video ready in '+total+'s');
@@ -3038,6 +3065,33 @@ function updatePipe(n,status,sub){
   const pipes=document.querySelectorAll('#pipelineEl .pipe');
   if(pipes[n-1]){pipes[n-1].className='pipe '+status;pipes[n-1].querySelector('.pipe-n').textContent=status==='done'?'✓':n;if(sub)pipes[n-1].querySelector('.pipe-sub').textContent=sub;}
 }
+function viewLockedPortrait(){
+  const p=S.persona;
+  const url=p?.loraUrl?(p.portrait||''):(p?.masterPortraitUrl||'');
+  if(!url){toast('No locked portrait found','err');return;}
+  window.open(url,'_blank');
+}
+function downloadLockedPortrait(){
+  const p=S.persona;
+  const url=p?.loraUrl?(p.portrait||''):(p?.masterPortraitUrl||'');
+  if(!url){toast('No locked portrait found','err');return;}
+  const a=document.createElement('a');
+  a.href=url;
+  a.download=(p?.name||'locked-portrait').replace(/\s+/g,'-').toLowerCase()+'-locked.png';
+  a.target='_blank';
+  document.body.appendChild(a);a.click();document.body.removeChild(a);
+  toast('Locked portrait downloading...');
+}
+function downloadPortraitUsed(){
+  const url = window._lastPortraitUrl || (S.persona?.masterPortraitUrl) || '';
+  if(!url){ toast('No portrait to download','err'); return; }
+  const a=document.createElement('a');
+  a.href=url;
+  a.download=window._lastPortraitName||(S.persona?.name||'portrait').replace(/\s+/g,'-').toLowerCase()+'.png';
+  a.target='_blank';
+  document.body.appendChild(a);a.click();document.body.removeChild(a);
+  toast('Portrait downloading...');
+}
 async function downloadVideo(url, filename){
   url = url || S.lastVideoUrl || (S.jobId?`${API()}/download/${S.jobId}`:null);
   if(!url){ toast('No video to download','err'); return; }
