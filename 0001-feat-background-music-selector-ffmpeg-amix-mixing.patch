+
+// Load background music tracks from backend and populate the music selector
+(async function loadMusicTracks(){
+  try{
+    const r=await fetch(API()+'/music-tracks');
+    const d=await r.json();
+    const list=document.getElementById('musicTrackList');
+    if(!list||!d.tracks||!d.tracks.length)return;
+    d.tracks.forEach(t=>{
+      const lbl=document.createElement('label');
+      lbl.style.cssText='display:flex;align-items:center;gap:10px;padding:10px;border-radius:9px;border:1px solid var(--border);background:var(--surface);cursor:pointer;transition:all .12s;';
+      lbl.innerHTML=`<input type="radio" name="bgMusic" value="${t.id}" style="accent-color:var(--purple);">
+        <div><div style="font-size:13px;font-weight:600;color:var(--muted);">${t.label}</div><div style="font-size:11px;color:var(--dim);">Plays softly under voiceover</div></div>`;
+      lbl.querySelector('input').addEventListener('change',function(){
+        document.querySelectorAll('#musicTrackList label').forEach(l=>{
+          l.style.borderColor='var(--border)';l.style.background='var(--surface)';
+          l.querySelector('div div:first-child').style.color='var(--muted)';
+        });
+        if(this.checked&&this.value){
+          lbl.style.borderColor='var(--purple)';lbl.style.background='var(--p3)';
+          lbl.querySelector('div div:first-child').style.color='var(--p2)';
+        }
+      });
+      list.appendChild(lbl);
+    });
+    // wire the "None" radio too
+    const noneInput=list.querySelector('input[value=""]');
+    if(noneInput)noneInput.addEventListener('change',function(){
+      if(this.checked){
+        document.querySelectorAll('#musicTrackList label').forEach(l=>{
+          l.style.borderColor='var(--border)';l.style.background='var(--surface)';
+          l.querySelector('div div:first-child').style.color='var(--muted)';
+        });
+        const noneLbl=this.closest('label');
+        noneLbl.style.borderColor='var(--purple)';noneLbl.style.background='var(--p3)';
+        noneLbl.querySelector('div div:first-child').style.color='var(--p2)';
+      }
+    });
+  }catch(e){console.warn('Could not load music tracks:',e);}
+})();
 </script>
