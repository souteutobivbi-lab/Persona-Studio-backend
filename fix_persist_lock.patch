+// ── Restore locked portraits from backend (survives Railway restarts) ──────
+(async function restoreLockedPortraits(){
+  try {
+    const r = await fetch(API()+'/locked-personas');
+    if(!r.ok) return;
+    const {locked} = await r.json();
+    let changed = false;
+    locked.forEach(({persona_id, fal_url})=>{
+      const p = S.personas.find(x => x.name === persona_id || x.name.toLowerCase() === persona_id.toLowerCase());
+      if(p && p.masterPortraitUrl !== fal_url){
+        p.masterPortraitUrl = fal_url;
+        changed = true;
+        console.log('Restored identity lock for', persona_id);
+      }
+    });
+    if(changed){ saveAll(); renderSidePersonas(); renderCreatePersonas(); }
+  } catch(e){ console.warn('Could not restore locked portraits:', e); }
+})();
+
