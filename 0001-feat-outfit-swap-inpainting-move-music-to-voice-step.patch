+async function swapOutfitOnly(){
+  const outfit = (document.getElementById('loraOutfitInp')?.value || '').trim();
+  const styling = (document.getElementById('loraStylingInp')?.value || '').trim();
+  const pid = S.persona?.id || S.persona?.name;
+  if(!pid){ toast('No persona selected','err'); return; }
+  if(!outfit){ toast('Enter an outfit first','err'); return; }
+  if(!S.persona?.masterPortraitUrl){
+    toast('No locked portrait — lock one in the Identity tab first','err'); return;
+  }
+  const outfitFull = styling ? `${outfit}, ${styling}` : outfit;
+  const btn = document.getElementById('swapOutfitBtn');
+  btn.disabled = true;
+  btn.textContent = '🔄 Swapping...';
+  toast('Swapping outfit — face & body stay identical...');
+  try{
+    const fd = new FormData();
+    fd.append('persona_id', pid);
+    fd.append('outfit', outfitFull);
+    const r = await fetch(`${API()}/swap-outfit`, {method:'POST', body:fd});
+    const data = await r.json();
+    if(!r.ok || data.error){ throw new Error(data.error||'Swap failed'); }
+    const jid = data.job_id;
+    // Poll portrait-status
+    const poll = setInterval(async()=>{
+      try{
+        const sr = await fetch(`${API()}/portrait-status/${jid}`);
+        const st = await sr.json();
+        if(st.status==='complete'){
+          clearInterval(poll);
+          btn.disabled=false; btn.textContent='🔄 Swap outfit only';
+          // Show result in the existing portrait result grid
+          const imgUrl = `${API()}${st.images[0]}`;
+          const genImg = document.getElementById('portraitLoraGenImg');
+          const refImg = document.getElementById('portraitLoraRefCompare');
+          if(genImg) genImg.src = imgUrl;
+          if(refImg && S.persona?.masterPortraitUrl) refImg.src = S.persona.masterPortraitUrl;
+          document.getElementById('portraitLoraResult').style.display='block';
+          // Cache as current portrait for video generation
+          const imgResp = await fetch(imgUrl);
+          const blob = await imgResp.blob();
+          S.portraitFile = new File([blob], 'portrait-swapped.png', {type:'image/png'});
+          S.portraitUrl = imgUrl;
+          toast('Outfit swapped — same face, body & background ✓');
+        } else if(st.status==='error'){
+          clearInterval(poll);
+          btn.disabled=false; btn.textContent='🔄 Swap outfit only';
+          toast(st.error||'Outfit swap failed','err');
+        }
+      }catch(e){ clearInterval(poll); btn.disabled=false; btn.textContent='🔄 Swap outfit only'; }
+    }, 3000);
+  }catch(e){
+    btn.disabled=false; btn.textContent='🔄 Swap outfit only';
+    toast(e.message||'Outfit swap failed','err');
+  }
+}
