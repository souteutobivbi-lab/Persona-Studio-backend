+                "eq=contrast=1.05:brightness=-0.02:saturation=0.92"
             ),
-            "-c:v", "libx264", "-crf", "17", "-c:a", "copy",
+            "-c:v", "libx264", "-crf", "18", "-preset", "fast",
+            "-c:a", "aac", "-b:a", "128k",
+            "-movflags", "+faststart",
             final_path, "-y"
         ], capture_output=True)
         print(f"[{jid}] ffmpeg done. Return code: {ret.returncode}")
